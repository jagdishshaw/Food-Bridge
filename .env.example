# ==============================================================================
# FoodBridge Environment Variables
# Copy this file to .env.local for local customization or set in Vercel/Supabase.
# Leave Supabase keys blank to run in zero-config Local SQLite mode (npm run dev).
# ==============================================================================

# --- Backend Mode ---
# Optional override: "auto" (default), "local", or "supabase"
FOODBRIDGE_BACKEND=auto
# Signing secret for local session cookies (set a strong random string in production)
FOODBRIDGE_SESSION_SECRET=foodbridge-local-dev-secret-change-me

# --- Supabase (Required for Production Deployment) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email Notifications (Swappable: Resend -> Nodemailer SMTP -> LocalLog) ---
EMAIL_FROM="FoodBridge <noreply@foodbridge.local>"
# Option 1: Resend (recommended on Vercel)
RESEND_API_KEY=
# Option 2: SMTP via Nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- App & Impact Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Configurable meal weight in kg (1 meal = 0.4 kg by default)
NEXT_PUBLIC_MEAL_WEIGHT_KG=0.4
# Estimated kg CO2e avoided per kg of surplus food redirected
NEXT_PUBLIC_CO2_PER_KG=2.5
# Maximum safe consumption window in hours from prepared_at
NEXT_PUBLIC_MAX_SAFE_HOURS=6
